generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String           @id @default(uuid())
  name              String
  email             String           @unique
  password          String
  role              String           @default("STAFF")
  isActive          Boolean          @default(true)
  canViewHistory    Boolean          @default(false)
  canViewSalary     Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  activityLogs      ActivityLog[]
  otps              Otp[]
  submittedRequests ExpenseRequest[]

  @@map("users")
}

model Otp {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("otps")
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())

  @@map("activity_logs")
}

model Payroll {
  id           String   @id @default(uuid())
  employeeName String
  month        Int
  year         Int
  baseSalary   Float    @default(0)
  allowances   Float    @default(0)
  deductions   Float    @default(0)
  netSalary    Float    @default(0)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([employeeName, month, year])
  @@map("payrolls")
}

model CompanySetting {
  id               String   @id @default(uuid())
  name             String
  address          String
  email            String
  phone            String
  logoUrl          String?
  website          String?
  taxNumber        String?
  bankName         String?
  bankAccount      String?
  bankHolder       String?
  docNameSph       String?
  docPrefixSph     String?
  docNameInvoice   String?
  docPrefixInvoice String?
  docNameExpense   String?
  docPrefixExpense String?
  docNamePo        String?
  docPrefixPo      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("company_settings")
}

model Client {
  id        String    @id @default(uuid())
  type      String    @default("COMPANY")
  name      String
  address   String?
  email     String?
  phone     String?
  pic       String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sphs      Sph[]
  invoices  Invoice[]

  @@map("clients")
}

model Product {
  id           String        @id @default(uuid())
  name         String
  description  String?
  price        Float         @default(0)
  unit         String        @default("pcs")
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sphItems     SphItem[]
  invoiceItems InvoiceItem[]

  @@map("products")
}

model Signature {
  id        String    @id @default(uuid())
  name      String
  title     String?
  imageUrl  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sphs      Sph[]
  invoices  Invoice[]

  @@map("signatures")
}

model Sph {
  id           String     @id @default(uuid())
  number       String     @unique
  date         DateTime
  validUntil   DateTime?
  clientId     String
  client       Client     @relation(fields: [clientId], references: [id])
  items        SphItem[]
  subtotal     Float      @default(0)
  taxRate      Float      @default(0)
  taxAmount    Float      @default(0)
  total        Float      @default(0)
  notes        String?
  status       String     @default("DRAFT")
  openingText  String?
  closingText  String?
  headerColor  String?
  signerTitle  String?
  signatureId    String?
  signature      Signature? @relation(fields: [signatureId], references: [id], onDelete: SetNull)
  sectionsConfig Json?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@map("sphs")
}

model SphItem {
  id          String   @id @default(uuid())
  sphId       String
  sph         Sph      @relation(fields: [sphId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  name        String
  description String?
  quantity    Float    @default(1)
  unit        String   @default("pcs")
  price       Float?
  total       Float?
  sectionKey  String   @default("main")
  nomor       String?
  sortOrder   Int      @default(0)
  perValue    Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("sph_items")
}

model Invoice {
  id           String        @id @default(uuid())
  number       String        @unique
  date         DateTime
  dueDate      DateTime
  clientId     String
  client       Client        @relation(fields: [clientId], references: [id])
  items        InvoiceItem[]
  subtotal     Float         @default(0)
  taxRate      Float         @default(0)
  taxAmount    Float         @default(0)
  total        Float         @default(0)
  paidAmount   Float         @default(0)
  notes        String?
  status       String        @default("UNPAID")
  payments     Payment[]
  openingText  String?
  closingText  String?
  headerColor  String?
  signatureId  String?
  signature    Signature?    @relation(fields: [signatureId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  name        String
  description String?
  quantity    Float    @default(1)
  unit        String   @default("pcs")
  price       Float    @default(0)
  total       Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("invoice_items")
}

model Payment {
  id        String   @id @default(uuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  amount    Float    @default(0)
  date      DateTime
  method    String   @default("TRANSFER")
  reference String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}

model Expense {
  id         String   @id @default(uuid())
  date       DateTime
  name       String
  category   String
  amount     Float    @default(0)
  department String?
  requestBy  String?
  notes      String?
  receipt    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("expenses")
}

model ExpenseRequest {
  id                String                       @id @default(uuid())
  number            String                       @unique
  date              DateTime
  dueDate           DateTime?
  detailsOfPayment  String?
  project           String?
  description       String?
  name              String
  email             String?
  beneficiary       String?
  bankNorek         String?
  rfpCategory       String                       @default("OTHERS")
  status            String                       @default("PENDING")
  notes             String?
  items             ExpenseRequestItem[]
  attachments       ExpenseRequestAttachment[]
  submittedByUserId String?
  submittedBy       User?                        @relation(fields: [submittedByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  @@map("expense_requests")
}

model ExpenseRequestAttachment {
  id        String         @id @default(uuid())
  requestId String
  request   ExpenseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fileName  String
  fileUrl   String
  mimeType  String
  fileSize  Int?
  createdAt DateTime       @default(now())

  @@map("expense_request_attachments")
}

model ExpenseRequestItem {
  id          String         @id @default(uuid())
  requestId   String
  request     ExpenseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  description String
  amount      Float          @default(0)
  createdAt   DateTime       @default(now())

  @@map("expense_request_items")
}

model FormToken {
  id          String    @id @default(uuid())
  token       String    @unique
  label       String?
  usedAt      DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  @@map("form_tokens")
}

// ─── PURCHASE ORDER ──────────────────────────────────────
model Po {
  id              String   @id @default(uuid())
  number          String   @unique
  date            DateTime
  dueDate         DateTime?
  supplier        String
  supplierAddress String?
  supplierPhone   String?
  supplierEmail   String?
  attention       String?
  project         String?
  description     String?
  items           PoItem[]
  subtotal        Float    @default(0)
  taxRate         Float    @default(0)
  taxAmount       Float    @default(0)
  total           Float    @default(0)
  notes           String?
  paymentTerms    String?
  status          String   @default("DRAFT")
  headerColor     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("pos")
}

model PoItem {
  id          String   @id @default(uuid())
  poId        String
  po          Po       @relation(fields: [poId], references: [id], onDelete: Cascade)
  name        String
  description String?
  quantity    Float    @default(1)
  unit        String   @default("pcs")
  price       Float    @default(0)
  total       Float    @default(0)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("po_items")
}

// ─── LAMPIRAN ────────────────────────────────────────────
model Lampiran {
  id           String            @id @default(uuid())
  nama         String
  deskripsi    String?
  tipe         String            @default("UPLOAD") // UPLOAD | EXCEL | WORD
  fileUrl      String?           // path relatif, e.g. /uploads/lampiran/xxx.xlsx
  fileName     String?           // original filename
  fileSize     Int?
  mimeType     String?
  templateData Json?             // untuk EXCEL / WORD builder
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  dokumen      DokumenLampiran[]

  @@map("lampiran")
}

model DokumenLampiran {
  id          String   @id @default(uuid())
  dokumenType String   // sph | invoice | po | kontrak | dll
  dokumenId   String
  lampiranId  String
  lampiran    Lampiran @relation(fields: [lampiranId], references: [id], onDelete: Cascade)
  urutan      Int      @default(0)
  createdAt   DateTime @default(now())

  @@unique([dokumenType, dokumenId, lampiranId])
  @@index([dokumenType, dokumenId])
  @@map("dokumen_lampiran")
}
